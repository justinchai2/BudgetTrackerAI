# ── Plaid (get from dashboard.plaid.com → Team Settings → Keys) ──────────────
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox    # sandbox | production

# Plaid access tokens — one per bank, generated by running: python plaid_setup.py
# The suffix after PLAID_ACCESS_TOKEN_ becomes the bank display name.
# Add as many banks as you need; remove the ones you don't use.
PLAID_ACCESS_TOKEN_CHASE=access-sandbox-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PLAID_ACCESS_TOKEN_CITI=access-sandbox-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PLAID_ACCESS_TOKEN_CAPITAL_ONE=access-sandbox-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PLAID_ACCESS_TOKEN_WELLS_FARGO=access-sandbox-...
# PLAID_ACCESS_TOKEN_BANK_OF_AMERICA=access-sandbox-...

# ── Google Sheets (get from Google Cloud Console) ─────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json   # path to your downloaded JSON key file
GOOGLE_SHEET_ID=your_google_sheet_id               # from the URL: /spreadsheets/d/SHEET_ID/edit

# ── Gemini AI (free at aistudio.google.com — use AI Studio key, not Cloud key) ─
GEMINI_API_KEY=your_gemini_api_key

# ── Discord (get from discord.com/developers/applications) ───────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token

# Channel IDs — right-click channel in Discord → Copy Channel ID (requires Developer Mode)
DISCORD_CHANNEL_ID=000000000000000000         # #budget-tracker  (digest + sync results)
DISCORD_ALERT_CHANNEL_ID=000000000000000000   # #budget-alerts   (bank issues, sub updates)
DISCORD_REVIEW_CHANNEL_ID=000000000000000000  # #budget-review   (category + subscription review)

# Server ID — right-click server name → Copy Server ID
DISCORD_GUILD_ID=000000000000000000

# ── Plaid webhook (optional — enables real-time transaction alerts) ────────────
WEBHOOK_PORT=3000
PLAID_WEBHOOK_SECRET=your_webhook_secret   # set in Plaid dashboard if using webhooks
