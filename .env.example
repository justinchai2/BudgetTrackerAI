# Plaid (get from dashboard.plaid.com)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox    # options: sandbox, production

# Plaid access tokens (one per bank — generated during Plaid Link setup)
PLAID_ACCESS_TOKEN_CHASE=your_chase_access_token
PLAID_ACCESS_TOKEN_CITI=your_citi_access_token
PLAID_ACCESS_TOKEN_CAPITAL_ONE=your_capital_one_access_token

# Google Sheets (get from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id

# Gemini AI (free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Discord (get from discord.com/developers)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_budget_tracker_channel_id       # #budget-tracker (digest + alerts)
DISCORD_ALERT_CHANNEL_ID=your_budget_tracker_channel_id # #budget-tracker (same as above)
DISCORD_REVIEW_CHANNEL_ID=your_budget_review_channel_id # #budget-review (uncertain merchants)
